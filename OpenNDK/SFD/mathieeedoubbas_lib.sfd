==bias 30
==public
==include <exec/types.h>
==include <libraries/mathlibrary.h>
==version 33
LONG IEEEDPFix(DOUBLE parm) (d0,d1)
DOUBLE IEEEDPFlt(LONG integer) (d0)
LONG IEEEDPCmp(DOUBLE leftParm, DOUBLE rightParm) (d0,d1,d2,d3)
LONG IEEEDPTst(DOUBLE parm) (d0,d1)
DOUBLE IEEEDPAbs(DOUBLE parm) (d0,d1)
DOUBLE IEEEDPNeg(DOUBLE parm) (d0,d1)
DOUBLE IEEEDPAdd(DOUBLE leftParm, DOUBLE rightParm) (d0,d1,d2,d3)
DOUBLE IEEEDPSub(DOUBLE leftParm, DOUBLE rightParm) (d0,d1,d2,d3)
DOUBLE IEEEDPMul(DOUBLE factor1, DOUBLE factor2) (d0,d1,d2,d3)
DOUBLE IEEEDPDiv(DOUBLE dividend, DOUBLE divisor) (d0,d1,d2,d3)
DOUBLE IEEEDPFloor(DOUBLE parm) (d0,d1)
DOUBLE IEEEDPCeil(DOUBLE parm) (d0,d1)
==end
