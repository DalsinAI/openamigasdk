VOID CloseOutlineFont(struct OutlineFont * olf, struct List * list) (a0,a1)
LONG WriteFontContents(BPTR fontsLock, CONST_STRPTR fontName, CONST struct FontContentsHeader * fontContentsHeader) (a0,a1,a2)
