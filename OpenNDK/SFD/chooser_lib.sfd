Class * CHOOSER_GetClass() ()
struct Node * AllocChooserNodeA(struct TagItem * tags) (a0)
==varargs
struct Node * AllocChooserNode(Tag tag1, ...) (a0)
VOID FreeChooserNode(struct Node * node) (a0)
VOID SetChooserNodeAttrsA(struct Node * node, struct TagItem * tags) (a0,a1)
==varargs
VOID SetChooserNodeAttrs(struct Node * node, Tag tag1, ...) (a0,a1)
VOID GetChooserNodeAttrsA(struct Node * node, struct TagItem * tags) (a0,a1)
==varargs
VOID GetChooserNodeAttrs(struct Node * node, Tag tag1, ...) (a0,a1)
==version 45
ULONG ShowChooser(Object * o, struct Window * w, ULONG xpos, ULONG ypos) (a0,a1,d0,d1)
VOID HideChooser(Object * o, struct Window * w) (a0,a1)
