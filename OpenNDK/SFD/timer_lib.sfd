==base _TimerBase
==basetype struct Device *
==libname timer.device
==bias 42
==public
==include <exec/types.h>
==include <exec/devices.h>
==include <devices/timer.h>
==version 33
VOID AddTime(TimeVal_Type * dest, CONST TimeVal_Type * src) (a0,a1)
VOID SubTime(TimeVal_Type * dest, CONST TimeVal_Type * src) (a0,a1)
LONG CmpTime(CONST TimeVal_Type * dest, CONST TimeVal_Type * src) (a0,a1)
==version 36
ULONG ReadEClock(struct EClockVal * dest) (a0)
VOID GetSysTime(TimeVal_Type * dest) (a0)
==end
