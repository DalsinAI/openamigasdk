CONST_STRPTR GetLocaleStr(CONST struct Locale * locale, ULONG stringNum) (a0,d0)
BOOL IsAlNum(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsAlpha(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsCntrl(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsDigit(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsGraph(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsLower(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsPrint(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsPunct(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsSpace(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsUpper(CONST struct Locale * locale, ULONG character) (a0,d0)
BOOL IsXDigit(CONST struct Locale * locale, ULONG character) (a0,d0)
struct Catalog * OpenCatalogA(CONST struct Locale * locale, CONST_STRPTR name, CONST struct TagItem * tags) (a0,a1,a2)
==varargs
struct Catalog * OpenCatalog(CONST struct Locale * locale, CONST_STRPTR name, Tag tag1, ...) (a0,a1,a2)
struct Locale * OpenLocale(CONST_STRPTR name) (a0)
BOOL ParseDate(CONST struct Locale * locale, struct DateStamp * date, CONST_STRPTR fmtTemplate, CONST struct Hook * getCharFunc) (a0,a1,a2,a3)
