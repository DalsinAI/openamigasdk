==base _SpeedBarBase
==basetype struct Library *
==libname speedbar.gadget
==bias 30
==public
==include <exec/types.h>
==include <exec/libraries.h>
==include <intuition/intuition.h>
==include <intuition/classes.h>
==include <intuition/classusr.h>
==include <exec/nodes.h>
==include <gadgets/speedbar.h>
==include <utility/tagitem.h>
==version 44
Class * SPEEDBAR_GetClass() ()
struct Node * AllocSpeedButtonNodeA(ULONG number, struct TagItem * tags) (d0,a0)
==varargs
struct Node * AllocSpeedButtonNode(UWORD number, ...) (d0,a0)
VOID FreeSpeedButtonNode(struct Node * node) (a0)
VOID SetSpeedButtonNodeAttrsA(struct Node * node, struct TagItem * tags) (a0,a1)
==varargs
VOID SetSpeedButtonNodeAttrs(struct Node * node, ...) (a0,a1)
VOID GetSpeedButtonNodeAttrsA(struct Node * node, struct TagItem * tags) (a0,a1)
==varargs
VOID GetSpeedButtonNodeAttrs(struct Node * node, ...) (a0,a1)
==end
